# Copy this file to .env. Never commit the real key.
TYPESAFE_API_KEY=
CENTRAL_MODEL_PROVIDER=jev
JEV_MODEL=jev-latest
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_EVENT_BATCH_SIZE=1
JEV_TEXT_MAX_CHARS=3500
# 0 disables the model request timeout; cancel from the app when needed.
CENTRAL_MODEL_TIMEOUT_MS=0
CENTRAL_MODEL_RETRIES=2
